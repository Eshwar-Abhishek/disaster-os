{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://disaster-os.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://disaster-os.onrender.com/auth/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://disaster-os.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!api|auth|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
